# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/

# --- Virtual environments ---
.venv/
venv/
env/

# --- Flask / SQLite ---
# Flask-SQLAlchemy keeps the SQLite database in an instance/ folder.
# The database is rebuilt from migrations + seed.py, so don't commit it.
instance/
*.db
*.sqlite
*.sqlite3
.flaskenv.local

# --- Secrets ---
.env
.env.*

# --- Testing / tooling ---
.pytest_cache/
.coverage
htmlcov/
.ipdb_history
.ipynb_checkpoints/

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store

# NOTE: do NOT ignore these; they should be committed:
#   Pipfile, Pipfile.lock, server/migrations/